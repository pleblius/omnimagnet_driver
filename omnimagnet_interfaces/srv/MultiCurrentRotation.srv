uint64[] omnimagnets # Config numbers for desired magnets
Vector3[] rotation_vectors # Index-associated rotation vectors (Can be length 1 to apply to all magnets)
float64[] rotation_freqs # Index-associated frequency values (Hz) (Can be length 1 to apply to all magnets)
float64[] current_strengths # Index-associated current strengths (A) (Can be length 1 to apply to all magnets)
float64[] phase_offsets # Index-associated rotation offset (Deg) (Can be length 1 to apply to all magnets)
float64 duration # Seconds
---
bool error # true if an error prevented driver from implementing desired control
string error_desc # Description of failure if error is true